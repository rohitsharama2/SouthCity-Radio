# Copy to .env and fill in from Supabase → Project Settings → API. Leave empty to run
# without accounts (library stays in the browser; admin publishing only from this computer).
# Both values are public by design. Never put the service_role / secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Android builds only: the hosted SouthCity server the app talks to (see README → Android).
VITE_SOUTHCITY_SERVER=
